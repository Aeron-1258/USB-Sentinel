# Backend environment variables
# Copy to .env and adjust for your setup
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (overrides FRONTEND_URL if set)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Auth
JWT_SECRET=change-me-to-random-32-chars
JWT_EXPIRES_IN=8h
ADMIN_USER=admin
# bcrypt hash for Admin@123 — generate with: node -e "console.log(require('bcryptjs').hashSync('Admin@123',10))"
# ADMIN_HASH=$2a$10$...
ANALYST_USER=analyst
# ANALYST_HASH=...
